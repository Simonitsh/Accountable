type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   user;
 };
type UserProfilePublic = 
 record {
   avatarColor: AvatarColor;
   avatarColorMode: AvatarColorMode;
   avatarShape: AvatarShape;
   bio: opt text;
   displayName: text;
   email: opt text;
   id: UserId;
   role: UserRole;
   timezone: text;
   timezoneOffsetMinutes: int;
   username: text;
 };
type UserId = principal;
type UpdateMacroGoalRequest = 
 record {
   iconName: opt text;
   themeColor: opt text;
 };
type UpdateHabitRequest = 
 record {
   endTime: opt text;
   endTimeMinutes: opt nat;
   iconName: opt text;
   ifThenPlan: opt text;
   isLockIn: opt bool;
   isTimeEdit: opt bool;
   lockInDurationMinutes: opt nat;
   obstacleTemplateId: opt ObstacleTemplateId;
   scheduledDays: opt vec text;
   startTime: opt text;
   startTimeMinutes: opt nat;
   themeColor: opt text;
   timezoneOffsetMinutes: int;
 };
type Timestamp = int;
type ReusableGoalPublic = 
 record {
   category: GoalCategory;
   id: GoalId;
   state: GoalState;
   wish: text;
   wishDescription: text;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type ResolveObstacleRequest = record {labelText: text;};
type RecordCheckInRequest = 
 record {
   checkInType: CheckInType;
   executedIfThen: bool;
   goalId: GoalId;
   lockInEndedAt: opt int;
   lockInStartedAt: opt int;
   obstacleTemplateId: opt ObstacleTemplateId;
   timezoneOffsetMinutes: int;
 };
type PartnerOverview = 
 record {
   activeHabitCount: nat;
   currentStreak: nat;
   profile: UserProfilePublic;
 };
type PartnerHabitError = 
 variant {
   notPartner;
   profileNotFound;
 };
type PartnerHabitDetail = 
 record {
   habits: vec HabitPublic;
   profile: UserProfilePublic;
 };
type ObstacleTemplateId = nat;
type ObstacleTemplate = 
 record {
   description: text;
   id: ObstacleTemplateId;
   owner: UserId;
   title: text;
 };
type ObstacleStat = 
 record {
   count: nat;
   obstacleName: text;
   obstacleTemplateId: opt ObstacleTemplateId;
 };
type MacroGoalPublic = 
 record {
   category: GoalCategory;
   createdAt: Timestamp;
   iconName: opt text;
   id: GoalId;
   outcome: text;
   owner: UserId;
   state: GoalState;
   themeColor: opt text;
   updatedAt: Timestamp;
   wish: text;
   wishDescription: text;
 };
type InteractionType = variant {highFive;};
type InteractionId = nat;
type Interaction = 
 record {
   checkInId: CheckInId;
   fromPrincipal: UserId;
   id: InteractionId;
   interactionType: InteractionType;
   timestamp: Timestamp;
 };
type IfThenEffectiveness = 
 record {
   notUsedPlan: FollowThroughRate;
   usedPlan: FollowThroughRate;
 };
type HabitPublic = 
 record {
   category: GoalCategory;
   createdAt: Timestamp;
   endTime: opt text;
   endTimeMinutes: nat;
   goalId: GoalId;
   iconName: opt text;
   id: GoalId;
   ifThenPlan: text;
   isLockIn: bool;
   lastEditedAt: opt Timestamp;
   lockInDurationMinutes: nat;
   obstacleTemplateId: opt ObstacleTemplateId;
   outcome: text;
   owner: UserId;
   scheduledDays: vec text;
   startTime: opt text;
   startTimeMinutes: nat;
   state: GoalState;
   themeColor: opt text;
   updatedAt: Timestamp;
   wish: text;
   wishDescription: text;
 };
type HabitAnalytics = 
 record {
   actualObstacles: vec ObstacleStat;
   category: GoalCategory;
   habitId: GoalId;
   habitName: text;
   ifThenEffectiveness: IfThenEffectiveness;
   predictedObstacle: opt ObstacleStat;
   shownUpDays: nat;
 };
type GoalWithHabitsPublic = 
 record {
   goal: MacroGoalPublic;
   habits: vec HabitPublic;
 };
type GoalState = 
 variant {
   active;
   completed;
   paused;
 };
type GoalId = nat;
type GoalCategory = 
 variant {
   Health;
   Learning;
   Leisure;
   Productivity;
   Social;
 };
type FollowThroughRate = 
 record {
   rate: float64;
   successes: nat;
   total: nat;
 };
type FeedItem = 
 record {
   checkIn: CheckIn;
   goalName: text;
   highFiveCount: nat;
   partnerAvatarColor: AvatarColor;
   partnerAvatarColorMode: AvatarColorMode;
   partnerAvatarShape: AvatarShape;
   partnerDisplayName: text;
 };
type DayOfWeekStat = 
 record {
   dayName: text;
   dayOfWeek: nat;
   rate: float64;
   successes: nat;
   total: nat;
 };
type CreateMacroGoalRequest = 
 record {
   category: GoalCategory;
   iconName: opt text;
   outcome: text;
   themeColor: opt text;
   wish: text;
   wishDescription: text;
 };
type CreateHabitRequest = 
 record {
   endTime: opt text;
   endTimeMinutes: opt nat;
   goalId: GoalId;
   iconName: opt text;
   ifThenPlan: text;
   isLockIn: bool;
   lockInDurationMinutes: opt nat;
   obstacleTemplateId: opt ObstacleTemplateId;
   scheduledDays: opt vec text;
   startTime: opt text;
   startTimeMinutes: opt nat;
   themeColor: opt text;
   wishDescription: opt text;
 };
type ConnectionStatus = 
 variant {
   accepted;
   pending;
   rejected;
 };
type ConnectionPublic = 
 record {
   createdAt: Timestamp;
   fromPrincipal: UserId;
   id: ConnectionId;
   status: ConnectionStatus;
   toPrincipal: UserId;
 };
type ConnectionId = nat;
type CheckInType = 
 variant {
   inProgress;
   missedCheckIn;
   missedCheckOut;
   skip;
   success;
 };
type CheckInId = nat;
type CheckIn = 
 record {
   checkInType: CheckInType;
   executedIfThen: bool;
   goalId: GoalId;
   id: CheckInId;
   lockInEndedAt: opt int;
   lockInStartedAt: opt int;
   obstacleTemplateId: opt ObstacleTemplateId;
   owner: UserId;
   timestamp: Timestamp;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type CategoryStat = 
 record {
   category: GoalCategory;
   rate: float64;
   successes: nat;
   total: nat;
 };
type AvatarShape = 
 opt variant {
       Hexagon;
       Pentagon;
       Square;
       Star;
       Triangle;
     };
type AvatarColorMode = 
 variant {
   BorderOnly;
   Fill;
 };
type AvatarColor = opt text;
type AnalyticsSummary = 
 record {
   bestDayOfWeek: opt nat;
   categoryBreakdown: vec CategoryStat;
   dayOfWeek: vec DayOfWeekStat;
   habits: vec HabitAnalytics;
   overallIfThenEffectiveness: IfThenEffectiveness;
   worstDayOfWeek: opt nat;
 };
service : {
  /// Create a habit inside an existing macro goal. `request.goalId` is
  /// REQUIRED — the habit must reference an existing macro goal owned by the
  /// caller. The habit inherits the parent's category; wish/outcome are
  /// sourced from the parent and read-only. The habit's wishDescription
  /// (displayed name) defaults to the parent's, but is overridden by
  /// `request.wishDescription` when the caller supplies one.
  createHabit: (request: CreateHabitRequest) ->
   (variant {
      err: text;
      ok: HabitPublic;
    });
  /// Create a macro goal (a container). Captured by the goal wizard:
  /// category, wish, outcome (wishDescription). Does NOT accept Lock-In or
  /// schedule fields.
  createMacroGoal: (request: CreateMacroGoalRequest) ->
   (variant {
      err: text;
      ok: MacroGoalPublic;
    });
  deleteCheckIn: (checkInId: CheckInId) ->
   (variant {
      err: variant {
             notFound;
             sealed: text;
             unauthorized;
           };
      ok;
    });
  /// Permanently delete a macro goal and all of its child habits in a single
  /// atomic operation. Removes every child habit's check-ins, timeline
  /// entries, and feed interactions before removing the habits and the goal
  /// itself. All-or-nothing: partial failure cannot leave dangling habits.
  /// Hard-delete is final — no soft-delete or recoverable state.
  deleteGoal: (goalId: GoalId) -> (variant {
                                     err: text;
                                     ok;
                                   });
  /// Permanently delete a single habit in one atomic operation. Removes the
  /// habit's check-ins, timeline entries, and feed interactions before
  /// removing the habit itself. All-or-nothing: partial failure cannot leave
  /// dangling check-ins. Hard-delete is final — no soft-delete or recoverable
  /// state. Scoped to one habit — does not touch the parent macro goal or
  /// sibling habits.
  deleteHabit: (habitId: GoalId) -> (variant {
                                       err: text;
                                       ok;
                                     });
  devReset: () -> ();
  execute: (qJson: text) -> (Result) query;
  getAnalytics: (timezoneOffsetMinutes: int) -> (AnalyticsSummary) query;
  getApiDoc: () -> (text) query;
  getCheckInsForGoal: (goalId: GoalId) -> (vec CheckIn) query;
  getCheckInsForGoalTimeline: (goalId: GoalId, fromTimestamp: int) ->
   (vec CheckIn) query;
  getCheckInsForPeriod: (goalId: GoalId, fromTimestamp: int, toTimestamp:
   int) -> (vec CheckIn) query;
  /// Retrieve a habit by ID. Only the owning caller can see it.
  getHabit: (habitId: GoalId) -> (opt HabitPublic) query;
  getInteractionCount: (checkInId: CheckInId) -> (nat) query;
  /// Retrieve a macro goal by ID. Only the owning caller can see it.
  getMacroGoal: (goalId: GoalId) -> (opt MacroGoalPublic) query;
  getMyProfile: () -> (UserProfilePublic);
  getPartnerFeed: () -> (vec FeedItem) query;
  /// Returns the full habit detail for a single partner. Returns #notPartner
  /// for any non-partner, pending-only, or unconnected caller — no habit data
  /// leaks.
  getPartnerHabits: (target: principal) ->
   (variant {
      err: PartnerHabitError;
      ok: PartnerHabitDetail;
    }) query;
  getUserProfile: (target: UserId) -> (opt UserProfilePublic) query;
  isUsernameAvailable: (username: text) -> (bool) query;
  listAllUsers: () -> (vec UserProfilePublic) query;
  listConnections: () -> (vec ConnectionPublic) query;
  /// List habits linked to a specific macro goal (by parent goalId).
  listHabitsByParent: (parentGoalId: GoalId) ->
   (variant {
      err: text;
      ok: vec HabitPublic;
    }) query;
  listMyCheckIns: () -> (vec CheckIn) query;
  /// List the caller's macro goals, each grouped with its linked habits.
  /// Supports the dashboard grouping requirement.
  listMyGoals: () -> (vec GoalWithHabitsPublic) query;
  /// Returns the caller's reusable macro goals for the wizard chips.
  /// Each entry exposes id, wish, wishDescription, state, and category.
  listMyReusableGoals: () -> (vec ReusableGoalPublic) query;
  /// Returns an overview row for every accepted, mutual partner of the
  /// caller. Each row has the partner's profile, active habit count, and
  /// current streak. Pending requests and non-partners are never included.
  listPartnerOverviews: () -> (vec PartnerOverview) query;
  listPendingRequests: () -> (vec ConnectionPublic) query;
  markCheckInIfThenUsed: (checkInId: CheckInId) ->
   (variant {
      err: variant {
             notFound;
             unauthorized;
           };
      ok;
    });
  recordCheckIn: (request: RecordCheckInRequest) -> (CheckIn);
  recordInteraction: (checkInId: CheckInId, interactionType:
   InteractionType) -> (Interaction);
  register: (username: text) -> (UserProfilePublic);
  /// Resolves a built-in obstacle label to one of the seven fixed built-in
  /// obstacles. The match is case-insensitive on the built-in title. If the
  /// label is not one of the seven built-ins, the call traps — a custom
  /// obstacle can never be created. Returns the matching built-in
  /// `ObstacleTemplate` with its stable id.
  resolveObstacleLabel: (request: ResolveObstacleRequest) ->
   (ObstacleTemplate);
  respondToConnection: (connectionId: ConnectionId, accept: bool) -> (bool);
  schema: () -> (text) query;
  sendConnectionRequest: (target: UserId) -> (ConnectionPublic);
  setTimezone: (tz: text) -> ();
  /// Transition a goal (macro or habit) to a new state.
  updateGoalState: (goalId: GoalId, newState: GoalState) -> (bool);
  /// Update an editable habit. wish/wishDescription/outcome/category are
  /// immutable (sourced from the parent macro goal).
  updateHabit: (habitId: GoalId, request: UpdateHabitRequest) ->
   (variant {
      err: text;
      ok: HabitPublic;
    });
  /// Update an editable macro goal. Only cosmetic fields are editable;
  /// wish/wishDescription/outcome/category are immutable after creation.
  updateMacroGoal: (goalId: GoalId, request: UpdateMacroGoalRequest) ->
   (variant {
      err: text;
      ok: MacroGoalPublic;
    });
  updateMyProfile: (displayName: opt text, avatarShape: AvatarShape,
   avatarColor: AvatarColor, avatarColorMode: opt AvatarColorMode, bio:
   opt text, email: opt text, timezoneOffsetMinutes: opt int) ->
   (variant {
      err: text;
      ok: UserProfilePublic;
    });
}
