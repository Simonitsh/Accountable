type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   user;
 };
type UserProfilePublic = 
 record {
   avatarColor: AvatarColor;
   avatarColorMode: AvatarColorMode;
   avatarShape: AvatarShape;
   bio: opt text;
   displayName: text;
   email: opt text;
   id: UserId;
   role: UserRole;
   timezone: text;
   timezoneOffsetMinutes: int;
   username: text;
 };
type UserId = principal;
type UpdateMacroGoalRequest = 
 record {
   iconName: opt text;
   themeColor: opt text;
 };
type UpdateHabitRequest = 
 record {
   endTime: opt text;
   endTimeMinutes: opt nat;
   iconName: opt text;
   ifThenPlan: opt text;
   isLockIn: opt bool;
   isTimeEdit: opt bool;
   lockInDurationMinutes: opt nat;
   scheduledDays: opt vec text;
   startTime: opt text;
   startTimeMinutes: opt nat;
   themeColor: opt text;
   timezoneOffsetMinutes: int;
 };
type Timestamp = int;
type ReusableGoalPublic = 
 record {
   category: GoalCategory;
   id: GoalId;
   state: GoalState;
   wish: text;
   wishDescription: text;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type RecordCheckInRequest = 
 record {
   checkInType: CheckInType;
   customObstacleNote: opt text;
   executedIfThen: bool;
   goalId: GoalId;
   lockInEndedAt: opt int;
   lockInStartedAt: opt int;
   obstacleTemplateId: opt ObstacleTemplateId;
   timezoneOffsetMinutes: int;
 };
type PartnerOverview = 
 record {
   activeHabitCount: nat;
   currentStreak: nat;
   profile: UserProfilePublic;
 };
type PartnerHabitError = 
 variant {
   notPartner;
   profileNotFound;
 };
type PartnerHabitDetail = 
 record {
   habits: vec HabitPublic;
   profile: UserProfilePublic;
 };
type ObstacleTemplateId = nat;
type ObstacleTemplate = 
 record {
   description: text;
   id: ObstacleTemplateId;
   owner: UserId;
   title: text;
 };
type ObstacleStat = 
 record {
   id: ObstacleTemplateId;
   title: text;
 };
type MacroGoalPublic = 
 record {
   category: GoalCategory;
   createdAt: Timestamp;
   iconName: opt text;
   id: GoalId;
   outcome: text;
   owner: UserId;
   state: GoalState;
   themeColor: opt text;
   updatedAt: Timestamp;
   wish: text;
   wishDescription: text;
 };
type InteractionType = variant {highFive;};
type InteractionId = nat;
type Interaction = 
 record {
   checkInId: CheckInId;
   fromPrincipal: UserId;
   id: InteractionId;
   interactionType: InteractionType;
   timestamp: Timestamp;
 };
type HabitPublic = 
 record {
   category: GoalCategory;
   createdAt: Timestamp;
   endTime: opt text;
   endTimeMinutes: nat;
   goalId: GoalId;
   iconName: opt text;
   id: GoalId;
   ifThenPlan: text;
   isLockIn: bool;
   lastEditedAt: opt Timestamp;
   lockInDurationMinutes: nat;
   obstacleTemplateId: opt ObstacleTemplateId;
   outcome: text;
   owner: UserId;
   scheduledDays: vec text;
   startTime: opt text;
   startTimeMinutes: nat;
   state: GoalState;
   themeColor: opt text;
   updatedAt: Timestamp;
   wish: text;
   wishDescription: text;
 };
type GoalWithHabitsPublic = 
 record {
   goal: MacroGoalPublic;
   habits: vec HabitPublic;
 };
type GoalState = 
 variant {
   active;
   completed;
   paused;
 };
type GoalId = nat;
type GoalCategory = 
 variant {
   Health;
   Learning;
   Leisure;
   Productivity;
   Social;
 };
type GoalAnalytics = 
 record {
   completionRate: float64;
   currentStreak: nat;
   daysInWindow: nat;
   daysShownUp: nat;
   goalId: GoalId;
   goalName: text;
   longestStreak: nat;
   totalMissed: nat;
   totalSkips: nat;
   totalSuccesses: nat;
 };
type FeedItem = 
 record {
   checkIn: CheckIn;
   goalName: text;
   highFiveCount: nat;
   partnerAvatarColor: AvatarColor;
   partnerAvatarColorMode: AvatarColorMode;
   partnerAvatarShape: AvatarShape;
   partnerDisplayName: text;
 };
type CreateObstacleRequest = 
 record {
   description: text;
   title: text;
 };
type CreateMacroGoalRequest = 
 record {
   category: GoalCategory;
   iconName: opt text;
   outcome: text;
   themeColor: opt text;
   wish: text;
   wishDescription: text;
 };
type CreateHabitRequest = 
 record {
   endTime: opt text;
   endTimeMinutes: opt nat;
   goalId: GoalId;
   iconName: opt text;
   ifThenPlan: text;
   isLockIn: bool;
   lockInDurationMinutes: opt nat;
   obstacleTemplateId: opt ObstacleTemplateId;
   scheduledDays: opt vec text;
   startTime: opt text;
   startTimeMinutes: opt nat;
   themeColor: opt text;
   wishDescription: opt text;
 };
type ConnectionStatus = 
 variant {
   accepted;
   pending;
   rejected;
 };
type ConnectionPublic = 
 record {
   createdAt: Timestamp;
   fromPrincipal: UserId;
   id: ConnectionId;
   status: ConnectionStatus;
   toPrincipal: UserId;
 };
type ConnectionId = nat;
type CheckInType = 
 variant {
   inProgress;
   missedCheckIn;
   missedCheckOut;
   skip;
   success;
 };
type CheckInId = nat;
type CheckIn = 
 record {
   checkInType: CheckInType;
   customObstacleNote: opt text;
   executedIfThen: bool;
   goalId: GoalId;
   id: CheckInId;
   lockInEndedAt: opt int;
   lockInStartedAt: opt int;
   obstacleTemplateId: opt ObstacleTemplateId;
   owner: UserId;
   timestamp: Timestamp;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type CategoryStat = 
 record {
   activeHabits: nat;
   category: GoalCategory;
   completionRate: float64;
   totalSkips: nat;
   totalSuccesses: nat;
 };
type AvatarShape = 
 opt variant {
       Hexagon;
       Pentagon;
       Square;
       Star;
       Triangle;
     };
type AvatarColorMode = 
 variant {
   BorderOnly;
   Fill;
 };
type AvatarColor = opt text;
type AnalyticsSummary = 
 record {
   actualObstacle: opt ObstacleStat;
   categoryStats: vec CategoryStat;
   checkInsWithPlan: nat;
   checkInsWithoutPlan: nat;
   dailySuccessRate30Days: vec float64;
   daysInWindow: nat;
   daysShownUp: nat;
   goals: vec GoalAnalytics;
   plannedMatchesActual: bool;
   plannedObstacle: opt ObstacleStat;
   successRateByWeekday: vec float64;
   successRateWithPlan: float64;
   successRateWithoutPlan: float64;
 };
service : {
  createHabit: (request: CreateHabitRequest) ->
   (variant {
      err: text;
      ok: HabitPublic;
    });
  createMacroGoal: (request: CreateMacroGoalRequest) ->
   (variant {
      err: text;
      ok: MacroGoalPublic;
    });
  createObstacleTemplate: (request: CreateObstacleRequest) ->
   (ObstacleTemplate);
  deleteCheckIn: (checkInId: CheckInId) ->
   (variant {
      err: variant {
             notFound;
             sealed: text;
             unauthorized;
           };
      ok;
    });
  deleteGoal: (goalId: GoalId) -> (variant {
                                     err: text;
                                     ok;
                                   });
  deleteHabit: (habitId: GoalId) -> (variant {
                                       err: text;
                                       ok;
                                     });
  devReset: () -> ();
  execute: (qJson: text) -> (Result) query;
  getAnalytics: (timezoneOffsetMinutes: int) -> (AnalyticsSummary) query;
  getCheckInsForGoal: (goalId: GoalId) -> (vec CheckIn) query;
  getCheckInsForGoalTimeline: (goalId: GoalId, fromTimestamp: int) ->
   (vec CheckIn) query;
  getCheckInsForPeriod: (goalId: GoalId, fromTimestamp: int, toTimestamp:
   int) -> (vec CheckIn) query;
  getHabit: (habitId: GoalId) -> (opt HabitPublic) query;
  getInteractionCount: (checkInId: CheckInId) -> (nat) query;
  getMacroGoal: (goalId: GoalId) -> (opt MacroGoalPublic) query;
  getMyProfile: () -> (UserProfilePublic);
  getPartnerFeed: () -> (vec FeedItem) query;
  getPartnerHabits: (target: principal) ->
   (variant {
      err: PartnerHabitError;
      ok: PartnerHabitDetail;
    }) query;
  getUserProfile: (target: UserId) -> (opt UserProfilePublic) query;
  isUsernameAvailable: (username: text) -> (bool) query;
  listAllUsers: () -> (vec UserProfilePublic) query;
  listConnections: () -> (vec ConnectionPublic) query;
  listHabitsByParent: (parentGoalId: GoalId) ->
   (variant {
      err: text;
      ok: vec HabitPublic;
    }) query;
  listMyCheckIns: () -> (vec CheckIn) query;
  listMyGoals: () -> (vec GoalWithHabitsPublic) query;
  listMyObstacleTemplates: () -> (vec ObstacleTemplate) query;
  listMyReusableGoals: () -> (vec ReusableGoalPublic) query;
  listPartnerOverviews: () -> (vec PartnerOverview) query;
  listPendingRequests: () -> (vec ConnectionPublic) query;
  recordCheckIn: (request: RecordCheckInRequest) -> (CheckIn);
  recordInteraction: (checkInId: CheckInId, interactionType:
   InteractionType) -> (Interaction);
  register: (username: text) -> (UserProfilePublic);
  respondToConnection: (connectionId: ConnectionId, accept: bool) -> (bool);
  schema: () -> (text) query;
  sendConnectionRequest: (target: UserId) -> (ConnectionPublic);
  setTimezone: (tz: text) -> ();
  updateGoalState: (goalId: GoalId, newState: GoalState) -> (bool);
  updateHabit: (habitId: GoalId, request: UpdateHabitRequest) ->
   (variant {
      err: text;
      ok: HabitPublic;
    });
  updateMacroGoal: (goalId: GoalId, request: UpdateMacroGoalRequest) ->
   (variant {
      err: text;
      ok: MacroGoalPublic;
    });
  updateMyProfile: (displayName: opt text, avatarShape: AvatarShape,
   avatarColor: AvatarColor, avatarColorMode: opt AvatarColorMode, bio:
   opt text, email: opt text, timezoneOffsetMinutes: opt int) ->
   (variant {
      err: text;
      ok: UserProfilePublic;
    });
}
